rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function bootstrapAdmin() {
      return signedIn()
        && request.auth.token.email == "luan.c.oliveira11@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return bootstrapAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    function isTeacher() {
      return isAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher");
    }

    function assignedToTeacher(teacherId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeTeacherId == teacherId;
    }

    function canReadCourse(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId))
        && (isAdmin()
          || (isTeacher()
            && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid)
          || (signedIn()
            && get(/databases/$(database)/documents/courses/$(courseId)).data.status == "published"
            && assignedToTeacher(
              get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId
            )));
    }

    function managesTeacher(teacherId) {
      return isAdmin() || (isTeacher() && request.auth.uid == teacherId);
    }

    function managesCourse(courseId) {
      return isAdmin()
        || (isTeacher()
          && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid);
    }

    function createsTeacherProfile(teacherId) {
      return isAdmin()
        || (isSelf(teacherId)
          && getAfter(/databases/$(database)/documents/users/$(teacherId)).data.role == "teacher");
    }

    function invitedAs(role) {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/userInvitations/$(request.auth.token.email))
        && get(/databases/$(database)/documents/userInvitations/$(request.auth.token.email)).data.role == role;
    }

    match /test/{docId} {
      allow get: if signedIn();
    }

    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin()
        || (isTeacher() && resource.data.activeTeacherId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (isSelf(userId)
          && request.auth.token.email_verified == true
          && request.resource.data.email == request.auth.token.email
          && (request.resource.data.role == "student" || invitedAs(request.resource.data.role)));
      allow update: if isAdmin()
        || (isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["name", "photoURL", "timezone", "updatedAt"]));
      allow delete: if isAdmin();
    }

    match /userInvitations/{email} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.email == email
        && request.resource.data.role in ["teacher", "student"];
      allow delete: if isAdmin() || (signedIn() && request.auth.token.email == email);
    }

    match /teacherProfiles/{teacherId} {
      allow read: if isAdmin() || isSelf(teacherId) || assignedToTeacher(teacherId);
      allow create: if createsTeacherProfile(teacherId);
      allow update: if managesTeacher(teacherId);
      allow delete: if isAdmin();
    }

    match /studentProfiles/{studentId} {
      allow read: if isSelf(studentId) || isAdmin()
        || (isTeacher()
          && exists(/databases/$(database)/documents/users/$(studentId))
          && get(/databases/$(database)/documents/users/$(studentId)).data.activeTeacherId == request.auth.uid);
      allow create: if isAdmin() || isSelf(studentId)
        || (isTeacher()
          && request.resource.data.studentId == studentId
          && request.resource.data.keys().hasOnly(["studentId", "notes", "updatedAt"])
          && exists(/databases/$(database)/documents/users/$(studentId))
          && get(/databases/$(database)/documents/users/$(studentId)).data.activeTeacherId == request.auth.uid);
      allow update: if isAdmin()
        || (isSelf(studentId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["englishLevel", "learningGoals", "updatedAt"]))
        || (isTeacher()
          && exists(/databases/$(database)/documents/users/$(studentId))
          && get(/databases/$(database)/documents/users/$(studentId)).data.activeTeacherId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["notes", "updatedAt"]));
      allow delete: if isAdmin();
    }

    match /teacherStudentRelationships/{relationshipId} {
      allow read: if isAdmin() || isSelf(resource.data.studentId)
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isAdmin()
        || (isTeacher()
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.status == "active");
      allow update, delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (signedIn() && resource.data.status == "published"
          && assignedToTeacher(resource.data.teacherId));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if managesTeacher(resource.data.teacherId)
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if managesTeacher(resource.data.teacherId);
    }

    match /modules/{moduleId} {
      allow read: if canReadCourse(resource.data.courseId);
      allow create: if managesCourse(request.resource.data.courseId);
      allow update: if managesCourse(resource.data.courseId)
        && request.resource.data.courseId == resource.data.courseId;
      allow delete: if managesCourse(resource.data.courseId);
    }

    match /lessons/{lessonId} {
      allow read: if canReadCourse(resource.data.courseId)
        && (isAdmin()
          || (isTeacher() && resource.data.teacherId == request.auth.uid)
          || resource.data.status == "published");
      allow create: if managesCourse(request.resource.data.courseId)
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if managesCourse(resource.data.courseId)
        && request.resource.data.courseId == resource.data.courseId
        && (isAdmin() || request.resource.data.teacherId == request.auth.uid);
      allow delete: if managesCourse(resource.data.courseId);
    }

    match /learningAssets/{assetId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (signedIn() && resource.data.status == "published"
          && assignedToTeacher(resource.data.teacherId));
      allow create: if managesTeacher(request.resource.data.teacherId);
      allow update: if managesTeacher(resource.data.teacherId)
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if managesTeacher(resource.data.teacherId);
    }

    match /assessments/{assessmentId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (signedIn() && resource.data.status == "published"
          && assignedToTeacher(resource.data.teacherId));
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if managesTeacher(resource.data.teacherId)
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if managesTeacher(resource.data.teacherId);
    }

    match /assessmentResults/{resultId} {
      allow read: if isAdmin()
        || (signedIn()
          && (resource.data.studentId == request.auth.uid
            || resource.data.teacherId == request.auth.uid));
      allow create: if isSelf(request.resource.data.studentId)
        && request.resource.data.status == "submitted";
      allow update: if isAdmin()
        || (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if isAdmin();
    }

    match /availabilitySlots/{slotId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || assignedToTeacher(resource.data.teacherId);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if managesTeacher(resource.data.teacherId)
          && request.resource.data.teacherId == resource.data.teacherId
        || (signedIn()
          && resource.data.status == "available"
          && request.resource.data.status == "booked"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"]));
      allow delete: if managesTeacher(resource.data.teacherId);
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (signedIn()
          && (resource.data.studentId == request.auth.uid
            || resource.data.teacherId == request.auth.uid));
      allow create: if isSelf(request.resource.data.studentId)
        && request.resource.data.status == "pending";
      allow update: if isAdmin()
        || (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt", "notes", "calendarSyncStatus",
              "zoomMeetingId", "zoomJoinUrl", "zoomStartUrl"]))
        || (isSelf(resource.data.studentId)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"]));
      allow delete: if isAdmin();
    }

    match /mediaAssets/{mediaId} {
      allow read: if isAdmin() || managesTeacher(resource.data.teacherId);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if managesTeacher(resource.data.teacherId);
    }

    match /storageQuotas/{quotaId} {
      allow read: if isAdmin() || (isTeacher() && quotaId == request.auth.uid);
      allow write: if isAdmin() || (isTeacher() && quotaId == request.auth.uid);
    }

    match /integrationConnections/{connectionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSelf(request.resource.data.userId);
      allow update: if isSelf(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin() || isSelf(resource.data.userId);
    }

    match /calendarEvents/{eventId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSelf(request.resource.data.userId);
      allow update, delete: if isAdmin() || isSelf(resource.data.userId);
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (isTeacher() && request.resource.data.userId is string)
        || isSelf(request.resource.data.userId);
      allow update: if isAdmin()
        || (isSelf(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]));
      allow delete: if isAdmin() || isSelf(resource.data.userId);
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.actorId == request.auth.uid);
      allow update, delete: if false;
    }
  }
}
