rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Only authenticated users can access uploaded learning assets and videos
    match /media/{teacherId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.auth.uid == teacherId ||
        request.auth.token.email == "luan.c.oliveira11@gmail.com"
      ) && request.resource.size < 500 * 1024 * 1024; // 500MB max per video
    }

    match /assets/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.size < 100 * 1024 * 1024; // 100MB for docs/PDFs
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
